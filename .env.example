# API key from https://isthereanydeal.com/apps/my/
ITAD_API_KEY=
# Optional: where the wishlist database is stored (defaults to ~/.deals-mcp/wishlist.db)
DEALS_DB_PATH=
# Optional: the country used for prices when a tool call does not give one
DEFAULT_COUNTRY=US
# For deal alerts: a Discord webhook URL (Server Settings > Integrations > Webhooks > New Webhook).
# Keep it secret, since anyone with the URL can post to the channel.
DISCORD_WEBHOOK_URL=
